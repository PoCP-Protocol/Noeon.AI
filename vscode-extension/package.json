{
  "name": "noeon-language",
  "displayName": "Noeon AI — Cognitive Programming Language",
  "description": "Syntax highlighting, LSP diagnostics, completion, and run command for Noeon (.ael)",
  "version": "0.9.0",
  "publisher": "PoCP-Protocol",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:noeon",
    "onCommand:noeon.runFile"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes"
  ],
  "contributes": {
    "languages": [
      {
        "id": "noeon",
        "aliases": ["Noeon", "AEL", "noeon"],
        "extensions": [".ael", ".noeon"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "noeon",
        "scopeName": "source.noeon",
        "path": "./syntaxes/noeon.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "noeon",
        "path": "./snippets/noeon.json"
      }
    ],
    "themes": [
      {
        "label": "Noeon Cognitive Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/noeon-dark.json"
      }
    ],
    "commands": [
      {
        "command": "noeon.runFile",
        "title": "Noeon: Run Current File"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PoCP-Protocol/Noeon.AI"
  },
  "license": "MIT"
}
