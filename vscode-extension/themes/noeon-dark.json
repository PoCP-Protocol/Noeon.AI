{
  "name": "Noeon Cognitive Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#0d1117",
    "editor.foreground": "#c9d1d9",
    "editor.lineHighlightBackground": "#161b22",
    "editor.selectionBackground": "#264f78",
    "editorCursor.foreground": "#58a6ff",
    "editorLineNumber.foreground": "#484f58",
    "editorLineNumber.activeForeground": "#c9d1d9",
    "sideBar.background": "#010409",
    "sideBar.foreground": "#c9d1d9",
    "activityBar.background": "#0d1117",
    "titleBar.activeBackground": "#0d1117",
    "statusBar.background": "#1a0a2e",
    "statusBar.foreground": "#d2a8ff",
    "terminal.background": "#0d1117",
    "terminal.foreground": "#c9d1d9"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment"],
      "settings": {
        "foreground": "#6e7681",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string"],
      "settings": {
        "foreground": "#a5d6ff"
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "name": "Contract Keywords (Task/Budget/Verify) — Blue: Structure",
      "scope": ["keyword.control.contract.noeon"],
      "settings": {
        "foreground": "#58a6ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Perception Keywords — Green: Sensing the world",
      "scope": ["keyword.control.perception.noeon"],
      "settings": {
        "foreground": "#3fb950",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Reasoning Keywords — Purple: Deep thought",
      "scope": ["keyword.control.reasoning.noeon"],
      "settings": {
        "foreground": "#d2a8ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Memory Keywords — Gold: Knowledge stored",
      "scope": ["keyword.control.memory.noeon"],
      "settings": {
        "foreground": "#e3b341",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Metacognition Keywords — Pink: Self-awareness",
      "scope": ["keyword.control.metacognition.noeon"],
      "settings": {
        "foreground": "#f778ba",
        "fontStyle": "bold"
      }
