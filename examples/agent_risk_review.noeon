PROFILE "general"
VERSION "1.0.0-alpha"

AGENT "RiskReviewer"
  GOAL "Approve or escalate payment requests based on risk scoring"
  MEMORY type=episodic
  TOOLS ["transaction_lookup", "risk_scoring", "fraud_signals"]
  POLICY require_human_approval=risk_high risk_threshold=0.80
  FLOW
    PERCEIVE source=payment_request modality=structured
    REASON strategy=risk_analysis depth=2
    ACT action=fetch_fraud_signals url="https://example.com/risk/signals" channel=web plugin=http_call mock=true
    DECIDE action=approve threshold=0.80 fallback=escalate
    ACT action=process_payment channel=ledger
    REFLECT
