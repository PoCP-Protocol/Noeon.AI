PROFILE "general"
VERSION "1.0.0"

FUSE relay {
  threshold: 0.65
  enforce: false
  human_must_approve: [external_send, dominant_shift]
}

AGENT "SelfAwareCopilot"
  GOAL "Demonstrate SELF introspection: read own canonical report during REFLECT and improve epistemic score"
  MEMORY type=episodic+semantic
  TOOLS ["echo/echo"]
  POLICY require_citation=true audit=true
  FLOW
    PERCEIVE source=user_query modality=text
    REASON strategy=evidence_first depth=2
    DECIDE action=respond threshold=0.75
    ACT action=draft_response channel=internal safety=low
    REFLECT depth=standard metric=ai_native_grade
