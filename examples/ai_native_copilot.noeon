PROFILE "general"
VERSION "1.0.0"

FUSE relay {
  threshold: 0.65
  enforce: false
  human_must_approve: [external_send, dominant_shift]
}

AGENT "EpistemicCopilot"
  GOAL "Answer with cited evidence; refuse or escalate when confidence is below floor"
  MEMORY type=episodic+semantic
  TOOLS ["web_search", "file_reader", "echo/echo"]
  POLICY require_citation=true audit=true
  FLOW
    PERCEIVE source=user_query modality=text
    REASON strategy=evidence_first depth=3
    DECIDE action=respond threshold=0.72
    ACT action=write_report channel=document
    REFLECT depth=standard
