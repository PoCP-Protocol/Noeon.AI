{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noeon.ai/schemas/cognitive-ir.schema.json",
  "title": "Noeon Cognitive IR v1.0-alpha",
  "type": "object",
  "required": [
    "name",
    "version",
    "nodes",
    "execution_order"
  ],
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "created_at": {
      "type": [
        "number",
        "integer",
        "string"
      ]
    },
    "stats": {
      "type": "object"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "execution_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "nodeType": {
      "enum": [
        "intent",
        "constraint",
        "process",
        "validate",
        "learn",
        "perceive",
        "decide",
        "commit",
        "collaborate",
        "evolve",
        "remember",
        "attend",
        "predict",
        "meta"
      ]
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "params",
        "children",
        "dependencies",
        "priority",
        "confidence",
        "source"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/nodeType"
        },
        "params": {
          "type": "object"
        },
        "children": {
          "type": "array"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priority": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  }
}
